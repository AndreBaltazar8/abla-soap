          </xsd:sequence>
          <xsd:attributeGroup ref="tns:Versioned"/>
          <xsd:attribute ref="c:channel"/>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="placeOrderResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="id" type="xsd:long"/>
            <xsd:element name="total" type="c:Money"/>
            <xsd:element name="count" type="xsd:integer"/>
            <xsd:element name="paid" type="xsd:boolean"/>
            <xsd:element name="blob" type="xsd:base64Binary" minOccurs="0"/>
            <xsd:element name="lines" type="tns:Line" minOccurs="0" maxOccurs="unbounded"/>
            <xsd:element name="maybe" type="xsd:string" nillable="true"/>
            <xsd:element name="more" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="session" type="xsd:string"/>
      <xsd:element name="ping" type="xsd:string"/>
      <xsd:element name="pong" type="xsd:int"/>
      <xsd:element name="OrderFault">
        <xsd:complexType><xsd:sequence><xsd:element name="reason" type="xsd:string"/></xsd:sequence></xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </wsdl:types>
  <wsdl:message name="placeOrder">
    <wsdl:part name="session" element="tns:session"/>
    <wsdl:part name="parameters" element="tns:placeOrder"/>
  </wsdl:message>
  <wsdl:message name="placeOrderResponse"><wsdl:part name="parameters" element="tns:placeOrderResponse"/></wsdl:message>
  <wsdl:message name="orderFault"><wsdl:part name="detail" element="tns:OrderFault"/></wsdl:message>
  <wsdl:message name="ping"><wsdl:part name="body" element="tns:ping"/></wsdl:message>
  <wsdl:message name="pong"><wsdl:part name="body" element="tns:pong"/></wsdl:message>
  <wsdl:message name="add">
    <wsdl:part name="a" type="xsd:int"/>
    <wsdl:part name="b" type="xsd:int"/>
  </wsdl:message>
  <wsdl:message name="addResponse"><wsdl:part name="sum" type="xsd:int"/></wsdl:message>
  <wsdl:portType name="Orders">
    <wsdl:operation name="placeOrder">
      <wsdl:input message="tns:placeOrder"/>
      <wsdl:output message="tns:placeOrderResponse"/>
      <wsdl:fault name="bad" message="tns:orderFault"/>
    </wsdl:operation>
    <wsdl:operation name="ping">
      <wsdl:input message="tns:ping"/>
      <wsdl:output message="tns:pong"/>
    </wsdl:operation>
    <wsdl:operation name="forget">
      <wsdl:input message="tns:ping"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:portType name="Sums">
    <wsdl:operation name="add">
      <wsdl:input message="tns:add"/>
      <wsdl:output message="tns:addResponse"/>
    </wsdl:operation>
    <wsdl:operation name="oldAdd">
      <wsdl:input message="tns:add"/>
      <wsdl:output message="tns:addResponse"/>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="OrdersSoap" type="tns:Orders">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="placeOrder">
      <soap:operation soapAction="urn:shop/placeOrder"/>
      <wsdl:input>
        <soap:header message="tns:placeOrder" part="session" use="literal"/>
        <soap:body parts="parameters" use="literal"/>
      </wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
      <wsdl:fault name="bad"><soap:fault name="bad" use="literal"/></wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="ping">
      <soap:operation soapAction=""/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="forget">
      <soap:operation soapAction="urn:shop/forget"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:binding name="SumsRpc12" type="tns:Sums">
    <soap12:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="add">
      <soap12:operation soapAction="urn:sums/add"/>
      <wsdl:input><soap12:body use="literal" namespace="urn:sums"/></wsdl:input>
      <wsdl:output><soap12:body use="literal" namespace="urn:sums"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="oldAdd">
      <soap12:operation soapAction="urn:sums/old"/>
      <wsdl:input><soap12:body use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></wsdl:input>
      <wsdl:output><soap12:body use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:binding name="OrdersHttp" type="tns:Orders">
    <http:binding verb="GET"/>
  </wsdl:binding>
  <wsdl:service name="ShopService">
    <wsdl:port name="OrdersPort" binding="tns:OrdersSoap"><soap:address location="https://shop.example:8443/orders"/></wsdl:port>
    <wsdl:port name="SumsPort" binding="tns:SumsRpc12"><soap12:address location="https://shop.example:8443/sums"/></wsdl:port>
    <wsdl:port name="HttpPort" binding="tns:OrdersHttp"><http:address location="https://shop.example:8443/get"/></wsdl:port>
  </wsdl:service>
</wsdl:definitions>
