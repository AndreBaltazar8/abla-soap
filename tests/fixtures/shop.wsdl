        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="open"/>
          <xsd:enumeration value="paid-in full"/>
        </xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="Small">
        <xsd:restriction base="xsd:integer"><xsd:totalDigits value="9"/></xsd:restriction>
      </xsd:simpleType>
      <xsd:simpleType name="Tags"><xsd:list itemType="xsd:string"/></xsd:simpleType>
      <xsd:group name="Audit">
        <xsd:sequence>
          <xsd:element name="by" type="xsd:string"/>
          <xsd:element name="at" type="xsd:dateTime" minOccurs="0"/>
