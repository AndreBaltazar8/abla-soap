            <xsd:element name="paid" type="xsd:boolean"/>
            <xsd:element name="blob" type="xsd:base64Binary" minOccurs="0"/>
            <xsd:element name="lines" type="tns:Line" maxOccurs="unbounded"/>
            <xsd:element name="tags" type="tns:Tags" minOccurs="0"/>
            <xsd:element name="maybe" type="xsd:string" nillable="true"/>
            <xsd:element name="plain" type="xsd:string" form="unqualified"/>
            <xsd:choice>
              <xsd:element name="email" type="xsd:string"/>
              <xsd:element name="phone" type="xsd:string"/>
            </xsd:choice>
            <xsd:element ref="c:note" minOccurs="0"/>
            <xsd:group ref="tns:Audit"/>
            <xsd:element name="address" minOccurs="0">
